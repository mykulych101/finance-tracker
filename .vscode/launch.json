{
	"version": "0.2.0",
		"compounds": [
		{
			"configurations": ["be sync", "fe"],
			"name": "fe+be",
			"presentation": {
				"order": 1
			},
			"stopAll": true
		},
	],
	"configurations": [
		{
			"consoleTitle": "React",
			"cwd": "${workspaceRoot}/frontend",
			"envFile": "${workspaceFolder}/.env",
			"name": "fe",
			"presentation": {
				"order": 2
			},
			"request": "launch",
			"runtimeArgs": ["run", "dev"],
			"runtimeExecutable": "yarn",
			"runtimeVersion": "22.13.0",
			"type": "node"
		},
		{
			"name": "fe:debug",
			"request": "launch",
			"type": "editor-browser",
			"url": "http://finance-tracker.local:3001",
			"webRoot": "${workspaceFolder}/frontend"
		},
		{
			"args": ["runserver", "--noreload"],
			"autoStartBrowser": false,
			"console": "internalConsole",
			"cwd": "${workspaceFolder}/backend",
			"django": true,
			"envFile": "${workspaceFolder}/.env",
			"justMyCode": false,
			"name": "be sync",
			"program": "${workspaceFolder}/backend/manage.py",
			"python": "${workspaceFolder}/backend/.venv/bin/python",
			"request": "launch",
			"type": "debugpy"
		},
		{
			"args": ["-A", "core", "beat", "-l", "INFO"],
			"console": "internalConsole",
			"cwd": "${workspaceFolder}/backend",
			"django": true,
			"envFile": "${workspaceFolder}/.env",
			"justMyCode": true,
			"module": "celery",
			"name": "celery beat",
			"python": "${workspaceFolder}/backend/.venv/bin/python",
			"request": "launch",
			"type": "debugpy"
		},
		{
			"args": ["-A", "core", "worker", "-l", "INFO", "-Q", "django,celery", "--pool=solo"],
			"console": "internalConsole",
			"cwd": "${workspaceFolder}/backend",
			"envFile": "${workspaceFolder}/.env",
			"justMyCode": true,
			"module": "celery",
			"name": "celery worker",
			"python": "${workspaceFolder}/backend/.venv/bin/python",
			"request": "launch",
			"type": "debugpy"
		},
		{
			"args": ["-A", "core", "flower", "--broker=redis://localhost:6379/0", "--port=5555"],
			"console": "internalConsole",
			"cwd": "${workspaceFolder}/backend",
			"envFile": "${workspaceFolder}/.env",
			"justMyCode": true,
			"module": "celery",
			"name": "flower",
			"python": "${workspaceFolder}/backend/.venv/bin/python",
			"request": "launch",
			"type": "debugpy"
		}
	]
}
